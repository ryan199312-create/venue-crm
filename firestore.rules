rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'super_admin';
    }

    function isAdminRole() {
      return isAuthenticated() && (request.auth.token.role == 'admin' || request.auth.token.role == 'super_admin');
    }

    function isStaffRole() {
      return isAuthenticated() && (request.auth.token.role == 'staff' || request.auth.token.role == 'admin' || request.auth.token.role == 'super_admin');
    }

    // Tenant binding: the caller must belong to {appId} (or be a super_admin).
    // FULL claim-only isolation: backfillTenantClaims (2026-07) stamped every user's
    // tenantId claim, so the migration-grace clause that admitted claimless users has
    // been removed. The app force-refreshes the ID token on load (AuthContext), so any
    // stale session self-heals on reload. A user can now only reach their own tenant.
    function belongsTo(appId) {
      return isSuperAdmin()
        || (isAuthenticated() && request.auth.token.tenantId == appId);
    }

    // --- LICENSING: branch (outlet) cap ---
    // A tenant's licensed branch count lives on /tenants/{appId}.maxBranches and is
    // writable ONLY by the super_admin (master admin). Any write to a tenant's
    // settings/config whose `outlets` array would exceed that cap is rejected here,
    // so the client UI cannot be bypassed (console/API/direct SDK all hit this).
    // A tenant with no maxBranches set yet is ungated (grace) — nobody is locked out
    // before the master admin assigns them a license.
    function branchLimit(appId) {
      return exists(/databases/$(database)/documents/tenants/$(appId))
             && 'maxBranches' in get(/databases/$(database)/documents/tenants/$(appId)).data
        ? get(/databases/$(database)/documents/tenants/$(appId)).data.maxBranches
        : 999999;
    }
    function withinBranchLimit(appId) {
      return !('outlets' in request.resource.data)
        || request.resource.data.outlets.size() <= branchLimit(appId);
    }

    // A suspended tenant is frozen: its members cannot write (super_admin is exempt so
    // the master admin can still manage/unsuspend). Reads are left open so the app can
    // still load and show the "suspended" screen.
    function tenantSuspended(appId) {
      return exists(/databases/$(database)/documents/tenants/$(appId))
        && get(/databases/$(database)/documents/tenants/$(appId)).data.status == 'suspended';
    }

    // --- GLOBAL TENANTS (SaaS Level) ---
    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();   // tightened: was any admin (cross-tenant hole)
    }

    // Rate-limit counters — written ONLY by Cloud Functions (Admin SDK bypasses rules).
    // No client may read or write them.
    match /rate_limits/{doc} {
      allow read, write: if false;
    }

    // Inbound-email reply routing (token -> {appId, eventId}). Written/read ONLY by Cloud
    // Functions (sendEventMessage mints them, inboundEmail resolves them). No client access.
    match /mail_routes/{doc} {
      allow read, write: if false;
    }

    // Per-tenant WhatsApp Cloud API credentials (access token + app secret). Cloud
    // Functions only — never exposed to any client, not even a tenant admin.
    match /messaging_secrets/{doc} {
      allow read, write: if false;
    }

    // WhatsApp inbound routing (phone_number_id -> {appId}). Cloud Functions only.
    match /wa_routes/{doc} {
      allow read, write: if false;
    }

    // --- ARTIFACTS NAMESPACE ---
    match /artifacts/{appId} {

      // Super admin has full cross-tenant access.
      allow read, write: if isSuperAdmin();

      // Public data (for the marketing website).
      match /public/data/settings/config {
        allow read: if true;
      }

      // Event orders — any authenticated tenant member may create/edit them, so every
      // RBAC role (staff, sales, finance, coordinator, kitchen…) can save its work.
      // The rules enforce tenant isolation + suspension; the fine-grained "who can do
      // what" is enforced in the app. Events never carry an `outlets` array, so the
      // branch cap doesn't apply here.
      match /private/data/events/{document=**} {
        allow read: if belongsTo(appId);
        allow write: if belongsTo(appId) && (isSuperAdmin() || !tenantSuspended(appId));
      }

      // Tenant-private data — now bound to the caller's tenant. Everything OTHER than
      // events (settings/config, users, …) is admin-only. Writes carrying an `outlets`
      // array are additionally capped by the tenant's license (super_admin exempt).
      // pending_users is excluded here — it is provisioned/activated only via Cloud
      // Functions so the maxUsers license can't be bypassed by direct client writes.
      match /private/data/{collection}/{document=**} {
        allow read: if belongsTo(appId) && collection != 'pending_users' && collection != 'client_credentials';
        allow write: if belongsTo(appId) && isAdminRole()
                     && (isSuperAdmin() || withinBranchLimit(appId))
                     && (isSuperAdmin() || !tenantSuspended(appId))
                     && collection != 'pending_users' && collection != 'client_credentials';
      }

      // Client-portal password hashes + session tokens. Read/written ONLY by Cloud
      // Functions (Admin SDK bypasses rules); no client — not even a tenant admin — may
      // read the hashes directly. Managed via setup/verify/resetClientPassword.
      match /private/data/client_credentials/{document=**} {
        allow read, write: if false;
      }

      // Whitelisted (pending) users — readable by tenant admins to manage the list;
      // all writes go through provisionUser / activateUser (Admin SDK bypasses rules).
      match /private/data/pending_users/{document=**} {
        allow read: if belongsTo(appId) && isAdminRole();
        allow write: if false;
      }

      // Settings config is publicly readable (client portal / website), tenant-admin writable.
      match /private/data/settings/config {
        allow read: if true;
        allow write: if belongsTo(appId) && isAdminRole()
                     && (isSuperAdmin() || withinBranchLimit(appId))
                     && (isSuperAdmin() || !tenantSuspended(appId));
      }

      // Public Calendar (read-only to the world; writes by the owning tenant's staff).
      match /public_calendar/{eventId} {
        allow read: if true;
        allow write: if belongsTo(appId) && isStaffRole();
      }
    }

    // Default: deny all.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
